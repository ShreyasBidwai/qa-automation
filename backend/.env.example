# =============================================================================
# Backend (FastAPI control plane) environment template.
# Copy to backend/.env for local dev. NO secrets in VCS (Standards §6); store
# references and inject real values at runtime. Config is loaded via
# pydantic-settings and the app fails fast at startup if a required var is missing.
# =============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | staging | production
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Logging (structured JSON, Standards §8) -------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=json

# --- Database: the platform's own store / "the Brain" (Postgres 16 + pgvector)
# SQLAlchemy URL. Host `db` matches the compose service name.
DATABASE_URL=postgresql+psycopg://qa_platform:change-me-locally@db:5432/qa_platform
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5

# --- Target databases (per-project, set at runtime via the API, NOT here) ---
# Documented for reference only — enforced by the dual-DB rule (TRD §10):
#   * a READ-ONLY connection to the real DB for introspection/reference
#   * a SEPARATE writable, ephemeral TEST DB for execution (never write to RO)

# --- AI provider (pluggable; dev shells to `claude -p`) (Architecture §8) ----
AI_PROVIDER_MODE=claude_cli    # claude_cli | api | self_hosted
AI_GENERATE_MODEL=claude-opus-4-8           # frontier tier — generation / oracle synthesis
AI_TRIAGE_MODEL=claude-haiku-4-5-20251001   # cheap tier — triage / parsing
AI_MAX_BUDGET_TOKENS=120000    # hard per-generation context cap (never a repo dump)
CLAUDE_CLI_PATH=claude         # used when AI_PROVIDER_MODE=claude_cli
# ANTHROPIC_API_KEY=           # set ONLY when AI_PROVIDER_MODE=api — leave empty here
BRAIN_MCP_URL=                 # optional Brain MCP server; empty = use local index

# --- Background jobs / queue (DB-backed to start) (Standards §10) ----------
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=2
JOB_WORKER_CONCURRENCY=4

# --- Timeouts (seconds) for external calls (Standards §12) -----------------
GIT_TIMEOUT_SECONDS=60
DB_TIMEOUT_SECONDS=30
AI_TIMEOUT_SECONDS=120
RUNNER_TIMEOUT_SECONDS=900
