# Keep the backend build context small (Engineering Standards §17).
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log
Dockerfile
.dockerignore
README.md
# Laravel fixture: vendor is installed at image-build time; generated tests and
# phpunit caches are runtime-only — never ship host copies into the context.
tests/fixtures/laravel-app/vendor/
tests/fixtures/laravel-app/.phpunit.cache/
tests/fixtures/laravel-app/tests/Feature/_generated/
