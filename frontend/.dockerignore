# Keep the frontend build context small (Engineering Standards §17).
# node_modules is intentionally excluded — it is rebuilt from the lockfile in
# the image. package.json and package-lock.json MUST stay in the context.
node_modules/
dist/
.vite/
.env
.env.*
!.env.example
coverage/
playwright-report/
test-results/
npm-debug.log*
*.log
Dockerfile
.dockerignore
README.md
