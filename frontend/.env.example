# =============================================================================
# Frontend (React + Vite operator console) environment template.
# Copy to frontend/.env for local dev. Only variables prefixed with `VITE_` are
# exposed to client code — NEVER put secrets in any VITE_ var, it ships to the
# browser (Standards §6).
# =============================================================================

# --- Dev server ------------------------------------------------------------
PORT=5173

# Vite dev-server proxy target for backend calls (/healthz, /readyz, /api).
# The browser stays same-origin and Vite proxies to the backend (no CORS).
# In compose the backend is the `backend` service; for host-only dev use
# http://localhost:8000. (Node-side var, not exposed to the browser.)
BACKEND_PROXY_TARGET=http://backend:8000

# --- Exposed to the browser (VITE_*) ---------------------------------------
# Base path for the versioned API; relative so the dev-server proxy handles it.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="QA Automation Platform"
