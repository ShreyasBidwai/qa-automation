# =============================================================================
# Polaris — root environment template (consumed by docker compose).
# Copy to `.env` and adjust locally. NEVER commit real secrets (Standards §6).
# Every value here has a built-in default, so the stack boots with NO `.env` —
# this file documents the knobs. See docs/running.md.
# =============================================================================

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=qa-automation

# --- Postgres (16 + pgvector) ----------------------------------------------
# Placeholder credentials for LOCAL dev only — replace, do not reuse anywhere
# shared. Compose builds the backend DATABASE_URL from these as:
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=qa_platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qa_platform
POSTGRES_PORT=5434

# --- Service ports (host-side) ---------------------------------------------
WEB_PORT=8080          # packaged stack: the single-origin web UI (make up)
BACKEND_PORT=8000      # dev stack only (make dev-up): backend direct
FRONTEND_PORT=5173     # dev stack only (make dev-up): Vite hot-reload server

# --- Backend runtime -------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# --- Run / ingest composition (the safe-stub demo defaults) ----------------
# stub  → zero-credential boot; a "stub run" fabricates one demo finding so the
#         whole finding flow is usable without any toolchains or AI.
# Switching off stub needs real infra (NOT wired into the packaged image):
#   EXECUTOR_MODE=orchestrator  needs the Pest/Playwright runner toolchains
#                               (the backend invokes runs as SUBPROCESSES).
#   INGESTOR_MODE=laravel       needs git + the source adapter to build the Brain.
EXECUTOR_MODE=stub
INGESTOR_MODE=stub

# --- Pluggable providers (not exercised by the stub path; documented switches) -
# AI: stub (no creds) | anthropic_api (Anthropic Messages API — PRODUCTION Claude) |
#     claude_cli (shells to the `claude` CLI, dev) | gemini (Gemini API). This is the
#     INSTANCE DEFAULT; a project can override it per-project from the UI
#     (anthropic_api | claude_cli | gemini). The layer is provider-agnostic: pick a
#     backend, set its key below, and runs use it. Generation + triage both honour it.
AI_PROVIDER_MODE=stub
# Anthropic API key — SECRET, env-ONLY (never in the DB, a payload, a URL, or logs;
# sent via the x-api-key header). Required only when a run uses the anthropic_api
# provider. Uses AI_GENERATE_MODEL (frontier) + AI_TRIAGE_MODEL (cheap) for tiering.
# ANTHROPIC_API_KEY=
# Gemini API key — SECRET, env-ONLY (never in the DB, a payload, a URL, or logs; it
# is sent via the x-goog-api-key header). Required only when a run uses the gemini
# provider. Get one from Google AI Studio. The model id is configurable too.
# GEMINI_API_KEY=
# GEMINI_GENERATE_MODEL=gemini-2.5-flash
# Optional rate-limit fallback: a comma-separated model chain tried in order. On a
# per-DAY 429 the run advances to the next model; per-MINUTE waits + retries the same
# one. Unset ⇒ a one-element chain of GEMINI_GENERATE_MODEL. Not a secret.
# GEMINI_MODEL_CHAIN=gemini-2.5-flash,gemini-2.0-flash
# Embeddings: stub (no download) | local (fastembed ONNX, downloads the model).
EMBEDDING_PROVIDER=stub
# Git ingestion (READ-ONLY): a token for private repos, injected at clone time,
# never logged. Leave unset for the stub path / public repos.
# GIT_TOKEN=
# Screenshot storage (ADR-0051): local (a gitignored on-disk dir; single-box only) |
# s3 (an S3-compatible bucket the runner AND control plane share — REQUIRED for the
# decoupled topology, so live-view/failure screenshots serve across containers).
SCREENSHOT_STORAGE=local
# S3 backend (SCREENSHOT_STORAGE=s3). AWS credentials are NOT set here — boto3 reads
# them from the standard chain (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or an IAM
# role). Set the endpoint for MinIO / non-AWS S3; leave unset for real AWS.
# SCREENSHOT_S3_BUCKET=polaris-screenshots
# SCREENSHOT_S3_ENDPOINT_URL=https://minio.internal:9000
# SCREENSHOT_S3_REGION=us-east-1
# SCREENSHOT_S3_PREFIX=screenshots

# --- REAL execution (`make up-real`) ---------------------------------------
# `make up-real` layers infra/docker-compose.real.yml on top, which sets the real
# modes ON THE RUNNER (EXECUTOR_MODE=orchestrator, INGESTOR_MODE=laravel,
# AI_PROVIDER_MODE=claude_cli, EMBEDDING_PROVIDER=local). You only supply the SECRETS
# below + the target checkout path, READ FROM THIS GITIGNORED .env. NEVER commit real
# values.
#
# Claude bridge token (REQUIRED for real generation). Generation runs `claude -p` on
# the HOST via `make bridge`, so the container keeps using YOUR Claude subscription
# WITHOUT mounting ~/.claude (a read-write, cross-uid mount corrupts the host login on
# every up/down). Run the bridge in another terminal: `make bridge`. Generate a shared
# secret and paste it on both sides (it's read from this .env):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# CLAUDE_BRIDGE_TOKEN=
# Optional (defaults shown): the URL the runner calls + the host bind/port the daemon
# listens on. Override the bind to 127.0.0.1 if you don't want it on all interfaces.
# CLAUDE_BRIDGE_URL=http://host.docker.internal:8787
# CLAUDE_BRIDGE_PORT=8787
# How many `claude -p` calls the bridge runs AT ONCE (test generation's bottleneck is
# serial AI calls). Default 1 = fully serial (the safe default). Raise it (e.g. 6) to
# fan out generation on your subscription: the bridge keeps N calls concurrent but the
# OAuth token REFRESH stays serial (a stale window's first call refreshes alone), so
# concurrent refreshes can't race. Set back to 1 if you ever see auth churn (ADR-0057).
# CLAUDE_BRIDGE_CONCURRENCY=1
# CLAUDE_BRIDGE_WARM_INTERVAL=600   # seconds between token warm-ups (rarely changed)
#
# Fernet key that encrypts target-account credentials at rest (ADR-0053). Needed if
# you configure a specific target account; generate one and paste it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TARGET_CREDENTIALS_KEY=
#
# Read-only Gitea token for private repos. Clone-at-ingest IS wired now: set a
# project's repo_url to a git URL and ingest clones it READ-ONLY (shallow, temp dir,
# cleaned up; token injected at fetch time, redacted from logs; no push path, ever).
# Needed only for private repos.
# GIT_TOKEN=
#
# Host path to a checked-out + `composer install`ed target repo, bind-mounted into
# the runner at /targets/app. Still needed for Pest EXECUTION (which needs vendor/);
# INGEST can instead use a git repo_url (above). Set the project's repo_url to the
# git URL (ingest clones it) or to this in-container path (a local checkout).
# TARGET_REPO_HOST_PATH=./targets/app
