# =============================================================================
# Polaris — root environment template (consumed by docker compose).
# Copy to `.env` and adjust locally. NEVER commit real secrets (Standards §6).
# Every value here has a built-in default, so the stack boots with NO `.env` —
# this file documents the knobs. See docs/running.md.
# =============================================================================

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=qa-automation

# --- Postgres (16 + pgvector) ----------------------------------------------
# Placeholder credentials for LOCAL dev only — replace, do not reuse anywhere
# shared. Compose builds the backend DATABASE_URL from these as:
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=qa_platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qa_platform
POSTGRES_PORT=5434

# --- Service ports (host-side) ---------------------------------------------
WEB_PORT=8080          # packaged stack: the single-origin web UI (make up)
BACKEND_PORT=8000      # dev stack only (make dev-up): backend direct
FRONTEND_PORT=5173     # dev stack only (make dev-up): Vite hot-reload server

# --- Backend runtime -------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# --- Run / ingest composition (the safe-stub demo defaults) ----------------
# stub  → zero-credential boot; a "stub run" fabricates one demo finding so the
#         whole finding flow is usable without any toolchains or AI.
# Switching off stub needs real infra (NOT wired into the packaged image):
#   EXECUTOR_MODE=orchestrator  needs the Pest/Playwright runner toolchains
#                               (the backend invokes runs as SUBPROCESSES).
#   INGESTOR_MODE=laravel       needs git + the source adapter to build the Brain.
EXECUTOR_MODE=stub
INGESTOR_MODE=stub

# --- Pluggable providers (not exercised by the stub path; documented switches) -
# AI: stub (no creds) | claude_cli (shells to the `claude` CLI) | gemini (Gemini
#     API). This is the INSTANCE DEFAULT; a project can override it per-project from
#     the UI (claude_cli | gemini). Generation falls back to this when a project has
#     no choice.
AI_PROVIDER_MODE=stub
# Gemini API key — SECRET, env-ONLY (never in the DB, a payload, a URL, or logs; it
# is sent via the x-goog-api-key header). Required only when a run uses the gemini
# provider. Get one from Google AI Studio. The model id is configurable too.
# GEMINI_API_KEY=
# GEMINI_GENERATE_MODEL=gemini-2.5-flash
# Embeddings: stub (no download) | local (fastembed ONNX, downloads the model).
EMBEDDING_PROVIDER=stub
# Git ingestion (READ-ONLY): a token for private repos, injected at clone time,
# never logged. Leave unset for the stub path / public repos.
# GIT_TOKEN=

# --- REAL execution (`make up-real`) ---------------------------------------
# `make up-real` layers infra/docker-compose.real.yml on top, which sets the real
# modes ON THE RUNNER (EXECUTOR_MODE=orchestrator, INGESTOR_MODE=laravel,
# AI_PROVIDER_MODE=claude_cli, EMBEDDING_PROVIDER=local) and bind-mounts the host
# `claude` CLI — so you don't set those here. You only supply the two SECRETS below
# + the target checkout path, READ FROM THIS GITIGNORED .env. NEVER commit real values.
#
# Fernet key that encrypts target-account credentials at rest (ADR-0053). Needed if
# you configure a specific target account; generate one and paste it:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TARGET_CREDENTIALS_KEY=
#
# Read-only Gitea token for the private repo. NOTE: clone-at-ingest is NOT yet wired
# — ingest reads a LOCAL checkout (TARGET_REPO_HOST_PATH below). Use this token to
# clone the repo on the HOST; it is plumbed to the runner for when checkout lands.
# GIT_TOKEN=
#
# Host path to the checked-out + `composer install`ed target repo, bind-mounted into
# the runner at /targets/app. Set the project's repo_url to that in-container path.
# TARGET_REPO_HOST_PATH=./targets/app
