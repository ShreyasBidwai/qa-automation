# =============================================================================
# Root environment template — consumed by docker compose to wire the dev stack.
# Copy to `.env` and adjust locally. NEVER commit real secrets (Standards §6).
# Per-service config lives in backend/.env.example and frontend/.env.example.
# =============================================================================

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=qa-automation

# --- Postgres (16 + pgvector) ----------------------------------------------
# Placeholder credentials for LOCAL dev only — replace, do not reuse in any
# shared/hosted environment. Compose builds the backend's DATABASE_URL from
# these as: postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=qa_platform
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=qa_platform
POSTGRES_PORT=5432

# --- Service ports (host-side) ---------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Backend runtime (optional; compose supplies sensible defaults) --------
APP_ENV=development
LOG_LEVEL=INFO
